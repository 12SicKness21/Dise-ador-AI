rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /uploads/{uid}/{orderId}/{fileName} {
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow read: if request.auth != null && request.auth.uid == uid;
    }
    match /orders/{orderId}/{fileName} {
      // Accesible por cualquier usuario autenticado (los orderIds son UUIDs v4
      // de 128 bits — imposibles de adivinar). firestore.get() cross-service
      // causa 403 en producción con el SDK de Storage.
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
