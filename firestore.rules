rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper: ¿el usuario autenticado es administrador? ───────────────────
    // Verifica si existe un documento admins/{email} con su email.
    // get()/exists() dentro de reglas leen directamente (no recursan en reglas).
    function isAdmin() {
      return request.auth != null
             && exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    // ¿La cuenta del usuario está activa? Si no tiene perfil (cuentas previas
    // a esta función) se considera activa; solo active==false la bloquea.
    function isActive() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid))
             || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active != false;
    }

    // ¿El usuario tiene al menos 1 crédito? Gate suave — el descuento real y
    // atómico lo hace la Cloud Function (processUpload) vía transacción.
    function hasCredits() {
      let u = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(u)
             && get(u).data.credits is number
             && get(u).data.credits >= 1;
    }

    // ─── Administradores ─────────────────────────────────────────────────────
    // get:   cada usuario puede leer SU PROPIO doc (para saber si es admin) y
    //        los admins pueden leer cualquiera.
    // list:  solo admins (para la pantalla de gestión).
    // write: solo admins (agregar/quitar otros admins).
    match /admins/{email} {
      allow get:   if request.auth != null
                   && (email == request.auth.token.email || isAdmin());
      allow list:  if isAdmin();
      allow write: if isAdmin();
    }

    // ─── Usuarios / Clientes ─────────────────────────────────────────────────
    // get:   cada usuario lee su propio perfil; los admins leen cualquiera.
    // list:  solo admins (pantalla de gestión de clientes).
    // write: solo admins (suspender, cambiar rol). La creación la hace la
    //        Cloud Function vía Admin SDK (omite reglas).
    match /users/{uid} {
      allow get:   if request.auth != null && (uid == request.auth.uid || isAdmin());
      allow list:  if isAdmin();
      allow write: if isAdmin();
    }

    // ─── Prompts ────────────────────────────────────────────────────────────
    // Lectura: cualquier usuario autenticado. Escritura: solo admins.
    match /prompts/{docId} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }

    // ─── Orders ─────────────────────────────────────────────────────────────
    // read:   el dueño (userId == su UID) O un admin (para estadísticas).
    // create: el cliente crea el pedido en status "pending" con sus datos.
    // update/delete: bloqueado en cliente — solo Cloud Functions vía Admin SDK.
    match /orders/{orderId} {
      allow read: if request.auth != null
                  && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if request.auth != null
                    && isActive()
                    && (isAdmin() || hasCredits())
                    && request.resource.data.userId   == request.auth.uid
                    && request.resource.data.userEmail is string
                    && request.resource.data.status   == "pending"
                    && request.resource.data.promptNames is list
                    && request.resource.data.promptNames.size() > 0
                    && request.resource.data.promptNames.size() <= 10;

      allow update, delete: if false;
    }
  }
}
