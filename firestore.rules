rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Prompts ────────────────────────────────────────────────────────────
    // Lectura: cualquier usuario autenticado.
    // Escritura: solo el administrador (UID único, no email).
    match /prompts/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == "Fb7DhwOnApOl8vT4nF1MlQzE8pm2";
    }

    // ─── Orders ─────────────────────────────────────────────────────────────
    // read:   solo el dueño (userId debe coincidir con el UID del token)
    // create: el cliente crea el pedido en status "pending" con sus datos
    // update/delete: bloqueado en cliente — solo Cloud Functions vía Admin SDK
    match /orders/{orderId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;

      allow create: if request.auth != null
                    && request.resource.data.userId   == request.auth.uid
                    && request.resource.data.userEmail is string
                    && request.resource.data.status   == "pending"
                    && request.resource.data.promptNames is list
                    && request.resource.data.promptNames.size() > 0
                    && request.resource.data.promptNames.size() <= 10;

      allow update, delete: if false;
    }
  }
}
