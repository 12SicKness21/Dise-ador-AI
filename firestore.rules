rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Prompts: solo admin escribe; cualquier usuario autenticado puede leer
    match /prompts/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.token.email == "admin@causas.com";
    }

    // Orders:
    //   - read: usuario lee solo los suyos
    //   - create: usuario crea pedidos propios con status "pending" (desde cliente)
    //   - update/delete: solo Admin SDK (Cloud Functions) — cliente bloqueado
    match /orders/{orderId} {
      allow read: if request.auth != null
                  && resource.data.uid == request.auth.uid;

      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == "pending";

      allow update, delete: if false;
    }
  }
}
